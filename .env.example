# Hapio API token (create one in the Hapio portal: https://hapio.app).
# Give it the abilities you want admins to have. It stays on the server.
HAPIO_API_TOKEN=

# Optional: override the API base URL.
HAPIO_BASE_URL=https://eu-central-1.hapio.net/v1

# Optional: extra hostnames allowed to use the proxy (comma-separated), e.g. when
# serving the panel behind a VPN/SSO hostname. localhost/127.0.0.1 are always allowed.
ADMIN_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Optional: running the panel behind a gateway, embedded, or with a limited
# token. All are off by default. NEXT_PUBLIC_ settings apply at build time.
# ---------------------------------------------------------------------------

# Leave HAPIO_API_TOKEN empty and forward these cookies (comma-separated) to
# HAPIO_BASE_URL instead, for a gateway that adds the token. HTTPS only (or
# localhost).
HAPIO_FORWARD_COOKIES=

# Origins allowed to embed the panel in an iframe (comma-separated). By
# default only the panel itself can.
ADMIN_FRAME_ANCESTORS=

# A slim notice above every page, with an optional link.
NEXT_PUBLIC_ADMIN_BANNER_TEXT=
NEXT_PUBLIC_ADMIN_BANNER_LINK=
NEXT_PUBLIC_ADMIN_BANNER_LINK_TEXT=

# Show a badge from this booking metadata key on the bookings list and detail,
# with labels per value as JSON, e.g. {"phone":"Booked by phone"}.
NEXT_PUBLIC_BOOKING_SOURCE_KEY=
NEXT_PUBLIC_BOOKING_SOURCE_LABELS=

# Metadata added to every booking created in the panel, as JSON,
# e.g. {"source":"admin"}. It wins over what's typed in the form.
NEXT_PUBLIC_BOOKING_CREATE_METADATA=

# Entities that can't be changed (comma-separated): locations, resources,
# services, schedules, bookings, booking-groups. Add :create, :update or
# :delete for one action only, e.g. bookings:delete. Pages still show the data.
NEXT_PUBLIC_ADMIN_READONLY=

# Sections left out of the sidebar, whose pages answer "not found":
# dashboard, calendar, bookings, booking-groups, locations, resources,
# services, project.
NEXT_PUBLIC_ADMIN_HIDDEN=

# Refetch bookings and the calendar every N milliseconds while the tab is
# visible (at least 5000), so bookings made elsewhere show up.
NEXT_PUBLIC_ADMIN_REFETCH_INTERVAL=

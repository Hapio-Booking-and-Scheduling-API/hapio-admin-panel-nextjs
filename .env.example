# Hapio API token (create one in the Hapio portal: https://hapio.app).
# Give it the abilities you want admins to have. It stays on the server.
HAPIO_API_TOKEN=

# Optional: override the API base URL.
HAPIO_BASE_URL=https://eu-central-1.hapio.net/v1

# Optional: extra hostnames allowed to use the proxy (comma-separated), e.g. when
# serving the panel behind a VPN/SSO hostname. localhost/127.0.0.1 are always allowed.
ADMIN_ALLOWED_HOSTS=

# Hapio API token (create one in the Hapio portal: https://hapio.app).
# Give it the abilities you want admins to have. It stays on the server.
HAPIO_API_TOKEN=

# Optional: override the API base URL.
HAPIO_BASE_URL=https://eu-central-1.hapio.net/v1

# Optional: extra hostnames allowed to use the proxy (comma-separated), e.g. when
# serving the panel behind a VPN/SSO hostname. localhost/127.0.0.1 are always allowed.
ADMIN_ALLOWED_HOSTS=

# Optional: FullCalendar Scheduler licence key. Enables the Calendar page's "Resources"
# layout (one row per resource). Without it, only the free calendar views are shown.
# See https://fullcalendar.io/license (commercial key, or one of the free licence keys
# when your use qualifies). Read at build time; rebuild after changing it.
NEXT_PUBLIC_FULLCALENDAR_LICENSE_KEY=

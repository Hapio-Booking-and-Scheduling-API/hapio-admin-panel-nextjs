    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",

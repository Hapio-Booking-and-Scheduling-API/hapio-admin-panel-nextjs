  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "mock": "node scripts/mock-hapio.mjs",
    "seed": "node scripts/seed-hapio.mjs",
    "test:watch": "vitest",
    "e2e:build": "node scripts/e2e-build.mjs",
    "test:e2e": "npm run e2e:build && playwright test",
    "test:e2e:only": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hapio/calendar-core": "^1.0.0",

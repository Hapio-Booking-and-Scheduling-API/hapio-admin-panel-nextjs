  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
